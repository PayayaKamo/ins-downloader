# Copy this file to ".env" and fill in your own values.
# ".env" is listed in .gitignore, so it will never be committed.
# Never put real credentials into ins_downloader.py or into this example file.

# Instagram account used for --login. Leave empty for public profiles.
# The script also accepts --login USER on the command line, which overrides this.
INS_USERNAME=

# Password for the account above. If empty, the script asks for it interactively.
INS_PASSWORD=

# Optional HTTP(S) proxy. The script also auto-detects the Windows system proxy.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7891
